# ============================================================================
# Chronos Executive Scheduling Platform - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit .env to version control
# ============================================================================

# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3001
HOST=localhost

# JWT & SECURITY
# ============================================================================
JWT_SECRET=your-secret-key-here-min-32-characters-long
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=7d

# GOOGLE CALENDAR & OAUTH
# ============================================================================
# Get these from Google Cloud Console: https://console.cloud.google.com

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# For production, add:
# GOOGLE_REDIRECT_URI_PROD=https://api.chronos.app/auth/google/callback

# PADDLE PAYMENT PROCESSING
# ============================================================================
# Get these from Paddle Dashboard: https://dashboard.paddle.com

PADDLE_VENDOR_ID=your-vendor-id
PADDLE_API_KEY=your-api-key
PADDLE_PRODUCT_ID=your-product-id
PADDLE_PRICE_ID=your-price-id

# For development, use Paddle Sandbox:
# PADDLE_ENVIRONMENT=sandbox

# DATABASE CONFIGURATION
# ============================================================================
# PostgreSQL Example (recommended for production):
# DATABASE_URL=postgres://user:password@localhost:5432/chronos

# MongoDB Example (alternative):
# DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/chronos

# SQLite Example (development only):
# DATABASE_URL=sqlite:./chronos.db

DATABASE_URL=sqlite:./chronos.db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# EMAIL CONFIGURATION
# ============================================================================
# SendGrid (recommended):
EMAIL_SERVICE=sendgrid
EMAIL_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@chronos.app

# Mailgun (alternative):
# EMAIL_SERVICE=mailgun
# EMAIL_DOMAIN=mg.chronos.app
# EMAIL_API_KEY=your-mailgun-api-key

# SMTP (if self-hosting):
# EMAIL_SERVICE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Email Templates
EMAIL_SUBJECT_CONFIRMED=Your Meeting is Confirmed
EMAIL_SUBJECT_REMINDER=Reminder: Your Meeting Tomorrow
EMAIL_SUBJECT_CANCELLATION=Meeting Cancelled

# CORS & SECURITY
# ============================================================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LOGGING
# ============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# Sentry (error tracking - optional):
# SENTRY_DSN=your-sentry-dsn

# CACHE CONFIGURATION (optional)
# ============================================================================
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# ANALYTICS (optional)
# ============================================================================
# Google Analytics
# GA_TRACKING_ID=UA-XXXXX-Y

# Mixpanel
# MIXPANEL_TOKEN=your-token

# STRIPE (alternative payment processor - optional):
# ============================================================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# TWILIO (SMS notifications - optional):
# ============================================================================
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# AWS (for S3, Lambda, etc. - optional):
# ============================================================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=chronos-uploads

# SLACK NOTIFICATIONS (optional):
# ============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XX

# MEETING ROOM CONFIGURATION
# ============================================================================
# Google Meet settings
GOOGLE_MEET_ENABLED=true

# Zoom settings (if using Zoom instead):
# ZOOM_CLIENT_ID=your-client-id
# ZOOM_CLIENT_SECRET=your-client-secret

# FEATURES & FLAGS
# ============================================================================
FEATURE_GOOGLE_CALENDAR=true
FEATURE_PADDLE_PAYMENTS=true
FEATURE_NDA_ENFORCEMENT=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_VIDEO_CONFERENCE=true
FEATURE_RECURRING_MEETINGS=false
FEATURE_TEAM_SCHEDULING=false
FEATURE_WAITLIST=false

# BUSINESS CONFIGURATION
# ============================================================================
# Company/Brand info
COMPANY_NAME=Chronos
COMPANY_WEBSITE=https://chronos.app
COMPANY_EMAIL=support@chronos.app
COMPANY_PHONE=+1-800-CHRONOS

# Business hours (in minutes from midnight)
BUSINESS_HOURS_START=540          # 9:00 AM
BUSINESS_HOURS_END=1020           # 5:00 PM
BUSINESS_HOURS_TIMEZONE=America/New_York

# Meeting slot duration
DEFAULT_SLOT_DURATION=30           # Minutes
MIN_ADVANCE_BOOKING=1440           # 24 hours in minutes
MAX_ADVANCE_BOOKING=8640           # 6 days in minutes

# Pricing configuration
CURRENCY=USD
TAX_RATE=0.08                     # 8% tax

# DEVELOPMENT/DEBUG
# ============================================================================
DEBUG=chronos:*
VERBOSE_LOGGING=false

# Skip email sending in development:
# SKIP_EMAIL_SENDING=true

# Use mock Google Calendar:
# USE_MOCK_CALENDAR=true

# Use mock Paddle payments:
# USE_MOCK_PAYMENTS=true

# ============================================================================
# PRODUCTION ENVIRONMENT OVERRIDES
# ============================================================================
# When NODE_ENV=production, also set:
#
# NODE_ENV=production
# PORT=3001
# GOOGLE_REDIRECT_URI=https://api.chronos.app/auth/google/callback
# CORS_ORIGIN=https://chronos.app
# LOG_LEVEL=info
# DATABASE_URL=postgres://prod-db-connection-string
# JWT_SECRET=production-secret-key-change-me
# PADDLE_ENVIRONMENT=production (remove sandbox setting)
# EMAIL_FROM=noreply@chronos.app
#
# ============================================================================

# INSTRUCTIONS
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Update values with your credentials
# 3. Keep .env in .gitignore (never commit!)
# 4. Restart server after changes: npm start
#
# For local development:
#   - Use ngrok: ngrok http 3001
#   - Update callback URIs with ngrok URL
#   - Update CORS_ORIGIN to ngrok URL
#
# For production deployment:
#   - Use strong random JWT_SECRET (32+ chars)
#   - Enable HTTPS
#   - Use production database
#   - Set NODE_ENV=production
#   - Configure error tracking (Sentry)
#   - Enable rate limiting
#   - Use strong email service
#
# ============================================================================

# VALIDATION
# ============================================================================
# For Vercel Frontend only:
# ✓ NEXT_PUBLIC_API_URL (required for backend communication)
#
# For Backend (.env backend file):
# ✓ GOOGLE_CLIENT_ID
# ✓ GOOGLE_CLIENT_SECRET
# ✓ GOOGLE_REDIRECT_URI
# ✓ PADDLE_VENDOR_ID
# ✓ PADDLE_API_KEY
# ✓ JWT_SECRET (min 32 chars)
# ✓ DATABASE_URL
# ✓ EMAIL_SERVICE
#
# ============================================================================

# SECURITY NOTES
# ============================================================================
# 1. NEVER commit .env to version control
# 2. Add to .gitignore: echo ".env" >> .gitignore
# 3. Use strong, random secrets (min 32 characters)
# 4. Rotate secrets regularly
# 5. Use different secrets for dev/prod
# 6. Store in environment variable manager (GitHub Secrets, Heroku Vars, etc)
# 7. Don't log sensitive values
# 8. Use HTTPS in production
# 9. Enable CORS only for your domain
# 10. Monitor API logs for suspicious activity
#
# ============================================================================

# TESTING
# ============================================================================
# For testing, you can use:
#
# TEST_DATABASE_URL=sqlite::memory:
# TEST_JWT_SECRET=test-secret-key-for-testing-only
# TEST_GOOGLE_CLIENT_ID=test-client-id
# TEST_GOOGLE_CLIENT_SECRET=test-client-secret
# TEST_PADDLE_API_KEY=test-paddle-key
# USE_MOCK_CALENDAR=true
# USE_MOCK_PAYMENTS=true
#
# Run tests: npm test
#
# ============================================================================
